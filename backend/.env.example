# Server
PORT=8080

# PostgreSQL (see docker-compose.yml at repo root)
DATABASE_URL="postgresql://offpay:offpay@localhost:5432/offpay?schema=public"

# JWT (protects your account/payment/mesh endpoints — /api/bridge/ingest stays
# open, since a real bridge node would authenticate via mTLS in production,
# not a user login)
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="2h"

# Every signup gets a VPA of "<username>@<VPA_DOMAIN>" and this starting
# balance — there's no real bank behind this demo.
VPA_DOMAIN="offpay"
SIGNUP_BONUS="1000.00"

# Idempotency + replay windows (seconds)
IDEMPOTENCY_TTL_SECONDS=86400
PACKET_MAX_AGE_SECONDS=86400
